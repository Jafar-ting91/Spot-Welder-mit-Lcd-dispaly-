
(rules PCB Meister-Spot Welder 1
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 7)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.5)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
  )
  (rule
    (width 200.0)
    (clear 200.0)
    (clear 100.0 (type smd_to_turn_gap))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    GND "Net-(U4-IN+)" "Net-(U4-IN-)" +3.3V "Net-(C7-Pad1)" OSCIN OSCOUT "Net-(C10-Pad1)"
    PC14 PC15 +5V "Charge +" "Net-(MP1-SS)" "Net-(MP1-SW)" "Net-(MP1-BS)" "Net-(MP1-COMP)"
    "Net-(C19-Pad1)" "Net-(MP2-SS)" "Net-(MP2-COMP)" "Net-(C22-Pad1)" "Net-(MP2-BS)" "Net-(MP2-SW)" +12V "19V IN"
    "8V out +" "Net-(C27-Pad2)" "Net-(TPS1-VFB)" "Net-(TPS1-BP5)" "Net-(TPS1-SS{slash}SD)" "Net-(TPS1-COMP)" "Net-(TPS1-BOOST)" "Net-(Q5-D)"
    "Net-(TPS1-ILIM)" "Net-(TPS1-BP10)" "Net-(C37-Pad1)" "Net-(D1-K)" "Net-(D2-K)" "Net-(D3-K)" "Net-(D4-K)" "Net-(D4-A)"
    CS SDA Reset A0 SCK PB4 "Net-(J3-Pin_3)" "Net-(J3-Pin_1)"
    BAT+ PA3 "Net-(J6-Pin_2)" "Net-(J6-Pin_3)" SWCLK SWIO "Net-(MCP1-INPUT)" "unconnected-(MCP1-NC-Pad3)"
    "Net-(MP1-FB)" "Net-(MP1-EN)" "Net-(MP2-FB)" "Net-(MP2-EN)" "Net-(Q1-D)" "Net-(Q1-G)" "Net-(Q2-D)" "Net-(Q2-G)"
    "Net-(Q3-G)" "Net-(Q5-G)" "Net-(R1-Pad2)" PA1 PA0 PB1 PB12 PB9
    "Net-(R16-Pad2)" "Net-(R17-Pad1)" PB8 PB6 PB7 PC13 PB14 PB13
    "Net-(TPS1-RT)" "Net-(TPS1-KFF)" "Net-(TPS1-SYNC)" "unconnected-(U1-PB11-Pad22)" "unconnected-(U1-PA12-Pad33)" NRST "unconnected-(U1-PA2-Pad12)" "unconnected-(U1-PB10-Pad21)"
    PB5 "unconnected-(U1-PA15-Pad38)" "unconnected-(U1-PA6-Pad16)" "unconnected-(U1-PB2-Pad20)" "unconnected-(U1-PA4-Pad14)" "unconnected-(U1-PA11-Pad32)" PB15 "unconnected-(U1-PB0-Pad18)"
    "Net-(U1-BOOT0)" "unconnected-(U1-PB3-Pad39)" "unconnected-(U4-A0-Pad2)" "unconnected-(U4-A1-Pad1)" "unconnected-(Y2-Pad3)" "unconnected-(Y2-Pad2)" "Net-(C39-Pad2)" "Net-(Q6-C)"
    "Net-(Q6-B)" "unconnected-(U1-VBAT-Pad1)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)